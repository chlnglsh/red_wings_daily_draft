{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "outDir": "../dist/types/client",
    "tsBuildInfoFile": "../dist/types/client/tsconfig.tsbuildinfo",
    "customConditions": ["browser"],
    "rootDir": "../src/client",
    "types": ["vite/client"],
    // The ported game (src/client/app/**) was written and type-checked against a
    // separate project without these two flags — relaxing them here rather than
    // rewriting otherwise-correct code just to satisfy checks it was never
    // written against. Still fully `strict`, just without these two extras.
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": false,
    // Mirrors the game's own tsconfig: `@team` is the Vite alias for the selected
    // team folder (vite.config.ts); type-check against the Red Wings one.
    "paths": { "@team": ["../src/client/app/teams/redwings"] }
  },
  "include": ["../src/client/**/*"],
  // main.tsx is the standalone web app's own Vite entry point (Devvit's entries
  // are game.tsx/splash.tsx, which import ./app/App directly) — it's unused here,
  // just incidentally swept in by the symlinked app/ folder matching the glob above.
  "exclude": ["../src/client/app/main.tsx"],
  "references": [
    {
      "path": "./tsconfig.shared.json"
    }
  ]
}
