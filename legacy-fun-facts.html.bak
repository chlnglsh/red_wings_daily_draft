<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Detroit Red Wings Fun Facts</title>
<style>
  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #ffffff;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
    color: #1a1a1a;
  }

  .card {
    background-color: #c8102e;
    border: 6px solid #1a1a1a;
    border-radius: 12px;
    padding: 40px;
    max-width: 500px;
    width: 90%;
    text-align: center;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25);
  }

  h1 {
    color: #ffffff;
    font-size: 1.8rem;
    margin-top: 0;
    margin-bottom: 24px;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  button {
    display: block;
    margin: 0 auto;
    background-color: #ffffff;
    color: #c8102e;
    border: none;
    border-radius: 10px;
    padding: 22px 48px;
    font-size: 1.5rem;
    font-weight: bold;
    cursor: pointer;
    transition: transform 0.1s ease, background-color 0.2s ease;
  }

  button:hover {
    background-color: #f2f2f2;
  }

  button:active {
    transform: scale(0.97);
  }

  #fact {
    margin-top: 28px;
    background-color: #ffffff;
    color: #1a1a1a;
    border-radius: 8px;
    padding: 20px;
    font-size: 1.05rem;
    line-height: 1.5;
  }

  #fact.fade-in {
    animation: fadeIn 0.4s ease;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
    min-height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #fact:empty {
    display: none;
  }
</style>
</head>
<body>

<div class="card">
  <h1>Detroit Red Wings Fun Facts</h1>
  <button id="factBtn">Give me a fact</button>
  <div id="fact"></div>
</div>

<script>
  const facts = [
    "The Detroit Red Wings are one of the 'Original Six' NHL teams, along with Boston, Chicago, Montreal, New York, and Toronto.",
    "The Red Wings have won 11 Stanley Cup championships, the most of any American-based NHL team.",
    "The team was founded in 1926 and was originally called the Detroit Cougars, then briefly the Detroit Falcons before becoming the Red Wings in 1932.",
    "Fans famously throw octopuses onto the ice during playoff games, a tradition dating back to 1952 called the 'Legend of the Octopus.'",
    "The team's iconic winged wheel logo represents the fast-paced, industrious spirit of Detroit, the Motor City.",
    "Gordie Howe, nicknamed 'Mr. Hockey,' played for the Red Wings for 25 seasons and is considered one of the greatest players of all time.",
    "Detroit's home arena, Little Caesars Arena, opened in 2017, replacing the historic Joe Louis Arena.",
    "The Red Wings made the playoffs for 25 consecutive seasons from 1991 to 2016, one of the longest streaks in North American pro sports history.",
    "Steve Yzerman captained the Red Wings for 20 seasons, longer than any other captain in NHL history for a single team.",
    "The team's nickname 'Hockeytown' was officially trademarked by the Red Wings organization in the 1990s."
  ];

  const factBtn = document.getElementById('factBtn');
  const factDiv = document.getElementById('fact');

  let lastIndex = null;

  factBtn.addEventListener('click', () => {
    let randomIndex;
    do {
      randomIndex = Math.floor(Math.random() * facts.length);
    } while (randomIndex === lastIndex);
    lastIndex = randomIndex;
    factDiv.textContent = facts[randomIndex];
    factDiv.classList.remove('fade-in');
    void factDiv.offsetWidth;
    factDiv.classList.add('fade-in');
  });
</script>

</body>
</html>
